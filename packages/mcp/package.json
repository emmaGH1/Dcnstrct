{
  "name": "@dcnstrct/mcp",
  "version": "0.1.0",
  "description": "Local stdio MCP server: list_runs, get_run, get_source, save_analysis",
  "main": "dist/index.js",
  "bin": {
    "dcnstrct-mcp": "dist/index.js"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-vm-modules ../../node_modules/jest/bin/jest.js --runInBand"
  },
  "dependencies": {
    "@dcnstrct/shared": "*",
    "@modelcontextprotocol/sdk": "*",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^22.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "tsx": "^4.17.0",
    "typescript": "^5.5.4"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^@dcnstrct/shared$": "<rootDir>/../shared/src/index.ts",
      "^\\.\\.\\/\\.\\.\\/\\.\\.\\/api\\/src\\/(.*)$": "<rootDir>/../api/src/$1"
    },
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/dist/"
    ]
  }
}
