{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "paths": {
      "@dcnstrct/shared": ["../shared/src/index.ts"],
      "@dcnstrct/contracts": ["../shared/src/contracts.ts"],
      "@dcnstrct/ui-contracts": ["../shared/src/ui-contracts.ts"]
    }
  },
  "include": ["src"],
  "exclude": ["node_modules"]
}
